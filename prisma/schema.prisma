// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                          String          @id @default(cuid())
  name                        String
  segment                     String
  marketAge                   String
  employees                   String
  avgRevenue                  String
  margin                      String
  activeClients               String
  productsServices            String
  cities                      String
  painPoints                  String
  objectives                  String // JSON-encoded array of selected objectives
  createdAt                   DateTime        @default(now())
  diagnostics                 Diagnostic[]
  documents                   Document[]
  meetingNotes                MeetingNote[]
  kpiEntries                  KpiEntry[]
  kpiSuggestions              KpiSuggestion[]
  performanceInsight          String? // Agente de Performance por Área — cache manual, botão "Gerar/Atualizar"
  performanceInsightUpdatedAt DateTime?
  webhookToken                String?         @unique // gerado sob demanda; null = webhook desativado pra essa empresa
  webhookEvents               WebhookEvent[]
  outboundWebhookUrl          String? // URL do ERP/CRM do cliente — ArcaOS dispara eventos (POST) pra cá
}

model WebhookEvent {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     String   @default("") // rótulo livre — ?source=... na URL, ou o header User-Agent de quem chamou
  payload    String // corpo bruto recebido (texto ou JSON), truncado se muito grande
  receivedAt DateTime @default(now())
}

model KpiEntry {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaKey       String
  indicatorName String
  month         String // "YYYY-MM"
  value         Float
  target        Float? // meta/planejado opcional, pro comparativo realizado x planejado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, areaKey, indicatorName, month])
}

model KpiSuggestion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaKey       String
  indicatorName String
  month         String
  value         Float
  status        String   @default("pendente") // pendente | aplicada | rejeitada
  createdAt     DateTime @default(now())
}

model Diagnostic {
  id                    String            @id @default(cuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                String            @default("em_andamento") // em_andamento | concluido | em_execucao
  aiNarrative           String? // JSON: { executiveSummary, areaInsights: [{ areaKey, causaRaiz, recomendacao }] }
  evolutionNarrative    String? // Agente de Evolução de Maturidade — gerado uma vez na conclusão, se houver diagnóstico anterior
  sprintReportContent   String? // Agente de Relatório de Sprint — cache manual, botão "Gerar/Atualizar"
  sprintReportUpdatedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  answers               Answer[]
  tasks                 Task[]
  verticalInsights      VerticalInsight[]
  sprints               Sprint[]
  epics                 Epic[]
}

model VerticalInsight {
  id            String     @id @default(cuid())
  diagnosticId  String
  diagnostic    Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey       String
  content       String // JSON: { analysis, recommendations: string[] }
  documentsUsed Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([diagnosticId, areaKey])
}

model MeetingNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawNotes  String
  summary   String? // JSON: { summary, decisions: string[], pending: string[] } — null without an AI key
  createdAt DateTime @default(now())
}

model Answer {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey      String
  questionId   String
  score        Int
  evidence     String     @default("")
  responsible  String     @default("")
  impact       String     @default("Médio") // Baixo | Médio | Alto
  urgency      String     @default("Média") // Baixa | Média | Alta
  risk         String     @default("Operacional") // Operacional | Financeiro | Comercial | Jurídico | Fiscal | Pessoas | Tecnologia
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([diagnosticId, areaKey, questionId])
}

model Document {
  id                  String          @id @default(cuid())
  companyId           String
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category            String // area key or "geral"
  originalName        String
  storedUrl           String // URL do blob no Vercel Blob (era um filename local antes da migração pra Postgres+Blob)
  mimeType            String
  size                Int
  aiSuggestedCategory String? // free-form document type guessed by the Classificador de Documentos agent
  aiConfidence        String? // "alta" | "baixa"
  createdAt           DateTime        @default(now())
  kpiSuggestions      KpiSuggestion[]
}

model Task {
  id                 String      @id @default(cuid())
  diagnosticId       String
  diagnostic         Diagnostic  @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey            String
  areaName           String
  title              String
  priority           String // Alta | Média | Baixa
  timeframe          String // 30 dias | 31 a 90 dias | 3 a 12 meses
  status             String      @default("todo") // todo | doing | done
  position           Int         @default(0)
  responsible        String      @default("")
  dueDate            DateTime?
  sprintId           String?
  sprint             Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId             String?
  epic               Epic?       @relation(fields: [epicId], references: [id], onDelete: SetNull)
  rootCause          String      @default("") // causa provável — auto-populada do aiNarrative na aprovação do plano
  successIndicator   String      @default("") // indicador de sucesso
  completionEvidence String      @default("") // evidência de conclusão
  dependencies       String      @default("") // dependências (texto livre)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  events             TaskEvent[]
}

model Epic {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  createdAt    DateTime   @default(now())
  tasks        Task[]
}

model TaskEvent {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  createdAt  DateTime @default(now())
}

model Sprint {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  name         String
  goal         String     @default("")
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  tasks        Task[]
}
