// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // texto puro de propósito — login mockado, não um cofre de credenciais real
  role      String   @default("consultor") // admin | consultor | cliente
  title     String   @default("") // cargo na visão organizacional da Arca (seção 16 do pitch do Cícero)
  companyId String? // vínculo real com uma empresa (role "cliente") — definido na tela /usuarios
  assignedVerticals String @default("[]") // JSON-encoded array de chaves de lib/verticals.ts — só role "consultor". Vazio = sem escopo, vê a carteira inteira (equipe pequena/admin); preenchido restringe a lista de empresas e o acesso a /empresas/[id]/modulo/[x] às verticais atribuídas (organograma por vertical do plano estratégico, p. 22)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id                          String                @id @default(cuid())
  name                        String
  segment                     String
  marketAge                   String
  employees                   String
  avgRevenue                  String
  margin                      String
  activeClients               String
  productsServices            String
  cities                      String
  painPoints                  String
  objectives                  String // JSON-encoded array of selected objectives
  onboardingResponsible       String                @default("") // responsável Arca definido na Trilha 1 (Onboarding)
  contractedVerticals         String                @default("[]") // JSON-encoded array de chaves de lib/verticals.ts — quais módulos (Arca Checkup por vertical) essa empresa contratou; 0, 1 ou N, independentes entre si
  createdAt                   DateTime              @default(now())
  erpConnections              ErpConnection[] // credenciais de ERP por provedor (Omie hoje; TOTVS/Voalle amanhã sem mudar o schema de novo)
  diagnostics                 Diagnostic[]
  documents                   Document[]
  meetingNotes                MeetingNote[]
  kpiEntries                  KpiEntry[]
  kpiSuggestions              KpiSuggestion[]
  performanceInsight          String? // Agente de Performance por Área — cache manual, botão "Gerar/Atualizar"
  performanceInsightUpdatedAt DateTime?
  webhookToken                String?               @unique // gerado sob demanda; null = webhook desativado pra essa empresa
  webhookEvents               WebhookEvent[]
  outboundWebhookUrl          String? // URL do ERP/CRM do cliente — ArcaOS dispara eventos (POST) pra cá
  users                       User[] // usuários vinculados (role "cliente")
  decisions                   Decision[] // histórico de decisões (Portal do Cliente / Comitê de Gestão)
  messages                    Message[] // comunicação com a Arca (Portal do Cliente)
  monthlyReports              MonthlyReport[] // scorecard mensal gerado pelo cron do Comitê de Gestão
  documentTransactions        DocumentTransaction[] // Agente de Extração Financeira — transações extraídas de extratos no Data Room
  partnerReferrals            PartnerReferral[] // indicações de parceiro recebidas por essa empresa (vertical Parceira)
  contracts                   Contract[] // Estrutura de receita (plano estratégico, p. 24) — setup, MRR, performance fee, projeto avulso
}

// Estrutura de receita Arca BTO (plano estratégico, p. 24): 4 tipos de
// contrato complementares. "value" é o valor em R$ pra setup/mrr/
// projeto_avulso; performance_fee não tem valor fixo — só um percentual
// sobre o ganho apurado periodicamente (ver ContractPerformanceRecord).
model Contract {
  id                 String                      @id @default(cuid())
  companyId          String
  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type               String // setup | mrr | performance_fee | projeto_avulso
  verticalKey        String? // vertical específica coberta (lib/verticals.ts) — null cobre a empresa toda ou várias
  value              Float? // R$: setup (à vista), mrr (mensal), projeto_avulso (escopo fechado) — null pra performance_fee
  feePercent         Float? // % sobre o ganho apurado (plano: 5–15%) — só performance_fee
  status             String                      @default("ativo") // ativo | encerrado | pendente
  startDate          DateTime
  endDate            DateTime?
  notes              String                      @default("")
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  performanceRecords ContractPerformanceRecord[]
}

// Apuração periódica (trimestral ou semestral, conforme o plano) de um
// contrato performance_fee. gainValue é o ganho em R$ que o cliente teve
// no período — dado real, entra manual porque não existe uma fonte única
// e confiável no sistema pra "economia gerada" (poderia vir de KpiEntry,
// mas a direção de melhora varia por indicador — nota fiscal errada de
// direção calcularia comissão errada, então fica com quem tem o contexto).
// feeValue é só gainValue * feePercent / 100, calculado e congelado na
// hora — não recalcula se o feePercent do contrato mudar depois.
model ContractPerformanceRecord {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  period     String // texto livre — "2026-T1", "2026-S1" etc, conforme a cadência combinada
  gainValue  Float
  feeValue   Float
  notes      String   @default("")
  createdAt  DateTime @default(now())
}

// Vertical Parceira (plano estratégico, p. 16) — não é uma vertical de
// diagnóstico como as 9 de lib/verticals.ts (sem área/perguntas no
// questionário); é um cadastro de parceiros homologados da Arca e o registro
// de quando um deles foi indicado pra uma empresa cliente.
// revenueModel é o modelo comercial que a Arca tem com O PARCEIRO (recorrente,
// da relação em si) — os 5 modelos de receita de parceria do plano (p. 19).
// Comissionamento é por indicação (PartnerReferral.commissionPercent/Value);
// os outros 4 são atributos do parceiro, não de uma indicação específica:
// Fee de Curadoria é uma taxa fixa pela homologação (curationFeeValue),
// Revenue Share é % sobre o faturamento mensal do PRÓPRIO parceiro
// (revenueSharePercent), Coparticipação e White Label não têm um número fixo
// — descrevem como o trabalho é dividido/rotulado, não quanto se cobra.
model Partner {
  id                  String            @id @default(cuid())
  name                String
  type                String // operacional | estrategica | comercial — as 3 categorias de parceria do plano
  category            String // ex.: "Jurídico", "Engenharia", "SaaS", "Fintech" — texto livre
  contactInfo         String            @default("")
  homologationStatus  String            @default("pendente") // pendente | homologado | suspenso
  slaHours            Int? // meta de SLA de atendimento em horas (plano: ≤48h) — o realizado vem de PartnerReferral.respondedAt
  revenueModel        String            @default("comissionamento") // comissionamento | coparticipacao | fee_curadoria | revenue_share | white_label
  curationFeeValue    Float? // Fee de Curadoria: taxa fixa em R$ pela gestão/homologação — só revenueModel="fee_curadoria"
  revenueSharePercent Float? // Revenue Share: % sobre o faturamento mensal do parceiro — só revenueModel="revenue_share"
  npsScore            Int? // NPS Arca Partner (-100 a 100) — leitura mais recente, atualizada manualmente
  createdAt           DateTime          @default(now())
  referrals           PartnerReferral[]
}

model PartnerReferral {
  id                 String    @id @default(cuid())
  partnerId          String
  partner            Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status             String    @default("indicado") // indicado | em_andamento | concluido | perdido
  notes              String    @default("")
  commissionPercent  Float? // % de comissão negociada com o parceiro sobre esta indicação
  commissionValue    Float? // valor apurado em R$ — preenchido quando a indicação vira negócio (status concluido)
  clientSatisfaction Int? // satisfação do cliente com o parceiro nesta indicação, 0–100 (plano: ≥90%)
  respondedAt        DateTime? // quando o parceiro de fato respondeu/engajou — mede o SLA realizado contra Partner.slaHours
  createdAt          DateTime  @default(now())
}

// Um provedor de ERP por empresa (@@unique). Antes disso era Company.omieAppKey/
// omieAppSecret, específico da Omie — generalizado pra suportar outros ERPs do
// diagrama do plano estratégico (TOTVS, Voalle) sem precisar de colunas novas
// na Company a cada integração. Texto puro de propósito, mesmo padrão de
// User.password neste MVP.
model ErpConnection {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider   String // "omie" hoje — livre pra "totvs"/"voalle" no futuro, sem migration nova
  appKey     String
  appSecret  String
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, provider])
}

model Decision {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  summary   String   @default("")
  decidedAt DateTime
  decidedBy String   @default("") // quem decidiu (nome livre, do form)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorName String
  authorRole String // admin | consultor | cliente
  body       String
  createdAt  DateTime @default(now())
}

model MonthlyReport {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         String // "YYYY-MM" — um scorecard por empresa por mês
  overallAverage Float
  maturityLevel  Int
  maturityLabel  String
  areaAverages   String // JSON: [{ areaKey, areaName, average, status }]
  taskStats      String // JSON: { total, done, overdue, noOwner }
  pendingCount   Int // tarefas abertas (todo/doing)
  decisionsCount Int
  kpiCount       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, period])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     String   @default("") // rótulo livre — ?source=... na URL, ou o header User-Agent de quem chamou
  payload    String // corpo bruto recebido (texto ou JSON), truncado se muito grande
  receivedAt DateTime @default(now())
}

model KpiEntry {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaKey       String
  indicatorName String
  month         String // "YYYY-MM"
  value         Float
  target        Float? // meta/planejado opcional, pro comparativo realizado x planejado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, areaKey, indicatorName, month])
}

model KpiSuggestion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaKey       String
  indicatorName String
  month         String
  value         Float
  status        String   @default("pendente") // pendente | aplicada | rejeitada
  createdAt     DateTime @default(now())
}

model Diagnostic {
  id                    String            @id @default(cuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status                String            @default("em_andamento") // em_andamento | concluido | em_execucao
  scope                 String            @default("completo") // "completo" (140 perguntas, 12 áreas) ou a areaKey de um diagnóstico de módulo/vertical isolado (ex.: "financeiro")
  aiNarrative           String? // JSON: { executiveSummary, areaInsights: [{ areaKey, causaRaiz, recomendacao }] }
  evolutionNarrative    String? // Agente de Evolução de Maturidade — gerado uma vez na conclusão, se houver diagnóstico anterior
  sprintReportContent   String? // Agente de Relatório de Sprint — cache manual, botão "Gerar/Atualizar"
  sprintReportUpdatedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  answers               Answer[]
  tasks                 Task[]
  verticalInsights      VerticalInsight[]
  sprints               Sprint[]
  epics                 Epic[]
}

model VerticalInsight {
  id            String     @id @default(cuid())
  diagnosticId  String
  diagnostic    Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey       String
  content       String // JSON: { analysis, recommendations: string[] }
  documentsUsed Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([diagnosticId, areaKey])
}

model MeetingNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawNotes  String
  summary   String? // JSON: { summary, decisions: string[], pending: string[] } — null without an AI key
  createdAt DateTime @default(now())
}

model Answer {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey      String
  questionId   String
  score        Int
  evidence     String     @default("")
  responsible  String     @default("")
  impact       String     @default("Médio") // Baixo | Médio | Alto
  urgency      String     @default("Média") // Baixa | Média | Alta
  risk         String     @default("Operacional") // Operacional | Financeiro | Comercial | Jurídico | Fiscal | Pessoas | Tecnologia
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([diagnosticId, areaKey, questionId])
}

model Document {
  id                  String                @id @default(cuid())
  companyId           String
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category            String // area key or "geral"
  originalName        String
  storedUrl           String // URL do blob no Vercel Blob (era um filename local antes da migração pra Postgres+Blob)
  mimeType            String
  size                Int
  aiSuggestedCategory String? // free-form document type guessed by the Classificador de Documentos agent
  aiConfidence        String? // "alta" | "baixa"
  createdAt           DateTime              @default(now())
  kpiSuggestions      KpiSuggestion[]
  transactions        DocumentTransaction[]
}

model DocumentTransaction {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date        String // "AAAA-MM-DD", como veio da extração
  description String
  amount      Float // positivo = entrada, negativo = saída
  category    String // fornecedor | imposto | despesa_pessoal | emprestimo | outro
  flagged     Boolean  @default(false)
  flagReason  String   @default("")
  status      String   @default("pendente") // pendente | confirmada | rejeitada
  createdAt   DateTime @default(now())
}

model Task {
  id                 String      @id @default(cuid())
  diagnosticId       String
  diagnostic         Diagnostic  @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  areaKey            String
  areaName           String
  title              String
  priority           String // Alta | Média | Baixa
  timeframe          String // 30 dias | 31 a 90 dias | 3 a 12 meses
  status             String      @default("todo") // todo | doing | done
  position           Int         @default(0)
  responsible        String      @default("")
  dueDate            DateTime?
  sprintId           String?
  sprint             Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epicId             String?
  epic               Epic?       @relation(fields: [epicId], references: [id], onDelete: SetNull)
  rootCause          String      @default("") // causa provável — auto-populada do aiNarrative na aprovação do plano
  successIndicator   String      @default("") // indicador de sucesso
  completionEvidence String      @default("") // evidência de conclusão
  dependencies       String      @default("") // dependências (texto livre)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  events             TaskEvent[]
}

model Epic {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  name         String
  description  String     @default("")
  createdAt    DateTime   @default(now())
  tasks        Task[]
}

model TaskEvent {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  createdAt  DateTime @default(now())
}

model Sprint {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  name         String
  goal         String     @default("")
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  tasks        Task[]
}
